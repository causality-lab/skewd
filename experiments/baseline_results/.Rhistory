## Exercise 3
set.seed(1)
nsim = 1000L
# Simulate x1 and x2
x1 = runif(n = nsim, min = 0, max = 1)
x2 = runif(n = nsim, min = 2, max = 4)
# simulate error on known relation for y
y = 3 + 2 * x1 - 0.5 * x2 + rnorm(n = nsim, mean = 0, sd = 1)
df_sim = data.frame(y = y, x1 = x1, x2 = x2)
head(df_sim)
# Compare learners with mlr
library(mlr)
library(mlr3misc)
lrn_lm <- makeLearner(id = "Linear Model", "regr.lm")
lrn_ridge <- makeLearner(id = "Ridge", "regr.cvglmnet", alpha = 0)
lrn_lasso <- makeLearner(id = "Lasso", "regr.cvglmnet", alpha = 1)
lrns <- list(lrn_lm, lrn_ridge, lrn_lasso)
task <- makeRegrTask(data = df_sim, target = "y")
benchmark(learners = lrns, tasks = task, resamplings = cv10,
measures = mse, show.info = FALSE)
## Add noise
library(mlr3misc)
# Define vector for amounts of noisy features to loop over:
nfeats <- c(0, 5, 10, 50, 100, 200, 300, 400, 500)
# We use repeated cross-validation to use the estimated
# generalization errors of the repetition (which was evaluated
# by a 10-fold cv) to visualize the generalization errors:
resample_desc <- makeResampleDesc(method = "RepCV", reps = 10L, folds = 3L)
# Define learners:
lrn_lm <- makeLearner(id = "Linear Model", "regr.lm")
lrn_ridge <- makeLearner(id = "Ridge", "regr.cvglmnet", alpha = 0)
lrn_lasso <- makeLearner(id = "Lasso", "regr.cvglmnet", alpha = 1)
lrns = list(lrn_lm, lrn_ridge, lrn_lasso)
# Define an empty dataset that contains the results of our simulation. Columns are the
# number of features, the corresponding mse, and the used learner:
df_res <- data.frame(nfeats = numeric(0L), mse = numeric(0L), learner = character(0L))
set.seed(1)
for (i in nfeats) {
# Create new dataset with as many noisy features as i:
df_sim <- data.frame(cbind(y = y, x1 = x1, x2 = x2, matrix(rnorm(nsim * i), nrow = nsim)))
# Define the corresponding task:
task <- makeRegrTask(data = df_sim, target = "y")
# Conduct the benchmark by just varying the task:
res <- benchmark(learners = lrns, tasks = task, resamplings = resample_desc,
measures = mse, show.info = FALSE)
# Not as pretty, but efficient. We extract the estimated
# generalization errors of the benchmark and bind the rows
# to the data frame containing the results:
perfs <- do.call(rbind, mlr3misc::imap(.x = getBMRPerformances(res)[[1]],
.f = function (x, nm) {
data.frame(nfeats = i, mse = x$mse, learner = nm)
}))
df_res <- rbind(df_res, perfs)
print(i)
}
# saveRDS(df_res, file = "./data/regularization_mlr.rds")
df_res <- readRDS(file = "./data/regularization_mlr.rds")
df_res
# visualize results
library(ggplot2)
ggplot(data = df_res, aes(x = as.factor(nfeats), y = mse, fill = learner)) +
geom_boxplot() +
xlab("Number of Noise Features") +
ylab("Generalization Error") +
scale_fill_brewer(palette = "Set1")
