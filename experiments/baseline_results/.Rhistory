newton_logreg <- function(X, y, theta_0, maxIter = 1000, tol = 0.0001){
# Helper functions:
# Current probabilities:
calc_probs <- function(X, theta){
# Compute the vector of (1 / (1 + exp(-x_i^T theta))) for each row x_i:
prob_values <- 1 / (1 + exp(-X %*% as.vector(theta)))
return(prob_values)
}
# Compute W:
new_W <- function(prob_values){
# Create the diagonal matrix:
diag_matrix <- diag(as.vector(prob_values*(1-prob_values)))
return(diag_matrix)
}
iter = 0
theta_old = theta_0
while(iter < maxIter){
iter = iter + 1
# Update the probabilities:
probs = calc_probs(X, theta_old)
# Update W:
W = new_W(probs)
# Update theta:
theta_new = theta_old + solve(t(X) %*% W %*% X) %*% t(X) %*% as.vector(y-probs)
# Check stopping criterion:
if(sqrt(sum((theta_new - theta_old)^2)) < tol){
break
}
theta_old = theta_new
}
return(list("theta" = theta_new, "n_iter" = iter))
}
