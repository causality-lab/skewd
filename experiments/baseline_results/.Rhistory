df = read.csv("Prostate_cancer.csv")
# Create design matrix while removing ID column and target from the design matrix
Xdf = as.matrix(df[,-c(1,2)])
# Add intercept
Xdf = cbind(1,Xdf)
colnames(Xdf)[1] = "intercept"
# Create target vector
y = df$diagnosis_result
y <- ifelse(y == "M", 1, 0)
result = newton_logreg(Xdf, y, rnorm(9, mean = 0, sd = 10^-4))
print(result)
# Remove ID column:
df_noID = df[,-1]
# Encode the target:
df_noID$diagnosis_result = ifelse(df$diagnosis_result == "M", 1, 0)
df_noID$diagnosis_result = as.factor(df_noID$diagnosis_result)
model = glm(diagnosis_result ~ ., family = binomial(link = "logit"), df_noID)
print(model$coefficients)
# Differences:
model$coefficients-result$theta
